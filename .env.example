# Mainnet RPC used for anvil forking, forge fork tests, and log scans
ETH_RPC_URL=https://ethereum-rpc.publicnode.com

# "local" = anvil fork at 127.0.0.1:8545 (chain id 31337), "mainnet" = real mainnet
NEXT_PUBLIC_CHAIN=local

# Browser-side RPC when NEXT_PUBLIC_CHAIN=mainnet
NEXT_PUBLIC_RPC_URL=https://ethereum-rpc.publicnode.com

# AlloDualClaim address — written automatically by `npm run anvil:setup` for local mode
NEXT_PUBLIC_CLAIM_ADDRESS=

# WalletConnect Cloud project id (placeholder is fine for local dev)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=00000000000000000000000000000000

# Optional dev-only impersonation (local fork only): set to a holder address
# to browse as that account via the wagmi mock connector — no wallet needed,
# anvil --auto-impersonate executes its unsigned transactions. Leave empty to
# connect a real wallet. `npm run anvil:setup -- --impersonate` fills this in
# with the richest holder (required for `npm run e2e`).
NEXT_PUBLIC_IMPERSONATE=

# Anvil fork RPC the browser uses when NEXT_PUBLIC_CHAIN=local
# (defaults to http://127.0.0.1:8545; set for a hosted fork, e.g. Railway)
NEXT_PUBLIC_FORK_RPC_URL=

# Postgres for signed send-off messages (Prisma). Next.js and the Prisma CLI
# both read .env.local first, then .env. Local dev without a database:
#   docker run -d --name allominati-pg -p 54329:5432 \
#     -e POSTGRES_PASSWORD=allominati -e POSTGRES_DB=allominati postgres:17-alpine
#   npx prisma migrate dev
# Unset in local mode, messages fall back to data/sendoff-messages.jsonl;
# mainnet refuses to run without it.
DATABASE_URL="postgresql://postgres:allominati@localhost:54329/allominati"
